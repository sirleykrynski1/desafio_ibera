    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const html = pm.response.text();",
          "const token = html.match(/name=\"_token\"\\s+value=\"([^\"]+)\"/);",
          "if (token) pm.collectionVariables.set('csrf_token', token[1]);"
        ]
      }
    }
